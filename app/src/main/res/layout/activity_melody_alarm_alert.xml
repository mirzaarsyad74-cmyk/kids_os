<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:gravity="center"
    android:background="@drawable/bg_melody"
    android:padding="24dp">

    <!-- Soft Glassmorphism Card -->
    <LinearLayout
        android:layout_width="440dp"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center_horizontal"
        android:background="@drawable/bg_control_center"
        android:padding="28dp"
        android:elevation="16dp">

        <TextView
            android:id="@+id/tv_alarm_alert_icon"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="⏰🌸"
            android:textSize="54sp"
            android:layout_marginBottom="12dp" />

        <TextView
            android:id="@+id/tv_alarm_alert_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Wake Up, Sunshine! ☀️"
            android:textColor="#831843"
            android:textSize="22sp"
            android:textStyle="bold"
            android:gravity="center" />

        <TextView
            android:id="@+id/tv_alarm_alert_subtitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="It's time to start your happy day! Have fun and shine! 💖"
            android:textColor="#9D174D"
            android:textSize="14sp"
            android:gravity="center"
            android:layout_marginTop="6dp"
            android:layout_marginBottom="24dp" />

        <!-- Buttons: Dismiss and Snooze -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center">

            <Button
                android:id="@+id/btn_alarm_snooze"
                android:layout_width="wrap_content"
                android:layout_height="48dp"
                android:text="Snooze 5m 💤"
                android:textColor="#831843"
                android:textSize="14sp"
                android:textStyle="bold"
                android:background="@drawable/bg_melody_chip_unselected"
                android:paddingHorizontal="20dp"
                android:layout_marginEnd="16dp" />

            <Button
                android:id="@+id/btn_alarm_dismiss"
                android:layout_width="wrap_content"
                android:layout_height="48dp"
                android:text="Dismiss 🌸"
                android:textColor="#FFFFFF"
                android:textSize="14sp"
                android:textStyle="bold"
                android:background="@drawable/bg_melody_chip_selected"
                android:paddingHorizontal="28dp" />

        </LinearLayout>

    </LinearLayout>

</LinearLayout>
