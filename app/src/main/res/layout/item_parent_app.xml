<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:gravity="center_vertical"
    android:padding="12dp"
    android:layout_marginBottom="6dp"
    android:background="@drawable/bg_app_card">

    <ImageView
        android:id="@+id/iv_parent_app_icon"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:scaleType="fitCenter"
        android:contentDescription="App Icon" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical"
        android:layout_marginStart="16dp"
        android:layout_marginEnd="16dp">

        <TextView
            android:id="@+id/tv_parent_app_name"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="App Name"
            android:textColor="#FFFFFF"
            android:textSize="16sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tv_parent_package_name"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="com.example.app"
            android:textColor="#9CA3AF"
            android:textSize="12sp" />
    </LinearLayout>

    <TextView
        android:id="@+id/tv_parent_app_category_badge"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_melody_chip_unselected"
        android:paddingLeft="10dp"
        android:paddingRight="10dp"
        android:paddingTop="5dp"
        android:paddingBottom="5dp"
        android:text="🎮 Games ▾"
        android:textColor="#9D174D"
        android:textSize="12sp"
        android:textStyle="bold"
        android:layout_marginEnd="8dp"
        android:clickable="true"
        android:focusable="true" />

    <TextView
        android:id="@+id/btn_lock_app"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_melody_chip_unselected"
        android:paddingHorizontal="8dp"
        android:paddingVertical="4dp"
        android:text="🔓 Free"
        android:textColor="#9D174D"
        android:textSize="11sp"
        android:textStyle="bold"
        android:layout_marginEnd="8dp"
        android:clickable="true"
        android:focusable="true" />

    <TextView
        android:id="@+id/btn_uninstall_app"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_melody_uninstall_btn"
        android:paddingHorizontal="10dp"
        android:paddingVertical="4dp"
        android:text="🗑️ Uninstall"
        android:textColor="#FFFFFF"
        android:textSize="11sp"
        android:textStyle="bold"
        android:layout_marginEnd="10dp"
        android:clickable="true"
        android:focusable="true" />

    <androidx.appcompat.widget.SwitchCompat
        android:id="@+id/switch_allow_app"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:thumbTint="#FF2A85"
        app:trackTint="#A855F7" />

</LinearLayout>
