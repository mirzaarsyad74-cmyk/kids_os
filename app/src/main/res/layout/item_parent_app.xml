<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:gravity="center_vertical"
    android:paddingHorizontal="12dp"
    android:paddingVertical="10dp"
    android:layout_marginBottom="6dp"
    android:background="@drawable/bg_app_card"
    android:clickable="true"
    android:focusable="true">

    <!-- App Icon -->
    <ImageView
        android:id="@+id/iv_parent_app_icon"
        android:layout_width="44dp"
        android:layout_height="44dp"
        android:scaleType="fitCenter"
        android:contentDescription="App Icon" />

    <!-- Center Info Column -->
    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical"
        android:layout_marginStart="12dp"
        android:layout_marginEnd="10dp">

        <!-- Line 1: App Name & Category Badge -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <TextView
                android:id="@+id/tv_parent_app_name"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="App Name"
                android:textColor="#FFFFFF"
                android:textSize="14sp"
                android:textStyle="bold"
                android:maxLines="1"
                android:ellipsize="end" />

            <TextView
                android:id="@+id/tv_parent_app_category_badge"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_melody_chip_unselected"
                android:paddingHorizontal="8dp"
                android:paddingVertical="3dp"
                android:text="🎮 Games ▾"
                android:textColor="#9D174D"
                android:textSize="11sp"
                android:textStyle="bold"
                android:layout_marginStart="6dp"
                android:clickable="true"
                android:focusable="true" />
        </LinearLayout>

        <!-- Line 2: Package / Controls (Lock & Uninstall) -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginTop="4dp">

            <TextView
                android:id="@+id/btn_lock_app"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_melody_chip_unselected"
                android:paddingHorizontal="7dp"
                android:paddingVertical="2dp"
                android:text="🔓 Free"
                android:textColor="#9D174D"
                android:textSize="10sp"
                android:textStyle="bold"
                android:layout_marginEnd="6dp"
                android:clickable="true"
                android:focusable="true" />

            <TextView
                android:id="@+id/btn_uninstall_app"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_melody_uninstall_btn"
                android:paddingHorizontal="7dp"
                android:paddingVertical="2dp"
                android:text="🗑️ Remove"
                android:textColor="#FFFFFF"
                android:textSize="10sp"
                android:textStyle="bold"
                android:layout_marginEnd="6dp"
                android:clickable="true"
                android:focusable="true" />

            <TextView
                android:id="@+id/tv_parent_package_name"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="com.example.app"
                android:textColor="#6B7280"
                android:textSize="10sp"
                android:maxLines="1"
                android:ellipsize="end" />
        </LinearLayout>
    </LinearLayout>

    <!-- Right: Prominent Allow/Block Toggle Switch -->
    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingStart="4dp">

        <androidx.appcompat.widget.SwitchCompat
            android:id="@+id/switch_allow_app"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:thumbTint="#FF2A85"
            app:trackTint="#A855F7" />
    </LinearLayout>

</LinearLayout>
