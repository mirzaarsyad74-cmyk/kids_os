<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="380dp"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:gravity="center_horizontal"
    android:padding="20dp"
    android:background="@drawable/bg_control_center">

    <!-- Header Icon & Title -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="🔒"
        android:textSize="32sp"
        android:layout_marginBottom="4dp" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Parent Verification"
        android:textColor="#831843"
        android:textSize="18sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/tv_pinpad_subtitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Enter 4-digit PIN to continue"
        android:textColor="#9D174D"
        android:textSize="12sp"
        android:layout_marginTop="2dp"
        android:layout_marginBottom="14dp" />

    <!-- 4 PIN Indicator Dots -->
    <LinearLayout
        android:id="@+id/layout_pin_dots"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center"
        android:layout_marginBottom="8dp">

        <View
            android:id="@+id/dot_1"
            android:layout_width="16dp"
            android:layout_height="16dp"
            android:layout_margin="8dp"
            android:background="@drawable/bg_melody_chip_unselected" />

        <View
            android:id="@+id/dot_2"
            android:layout_width="16dp"
            android:layout_height="16dp"
            android:layout_margin="8dp"
            android:background="@drawable/bg_melody_chip_unselected" />

        <View
            android:id="@+id/dot_3"
            android:layout_width="16dp"
            android:layout_height="16dp"
            android:layout_margin="8dp"
            android:background="@drawable/bg_melody_chip_unselected" />

        <View
            android:id="@+id/dot_4"
            android:layout_width="16dp"
            android:layout_height="16dp"
            android:layout_margin="8dp"
            android:background="@drawable/bg_melody_chip_unselected" />

    </LinearLayout>

    <!-- Error text -->
    <TextView
        android:id="@+id/tv_pinpad_error"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Incorrect PIN. Please try again."
        android:textColor="#E11D48"
        android:textSize="12sp"
        android:textStyle="bold"
        android:visibility="invisible"
        android:layout_marginBottom="8dp" />

    <!-- Built-in Numeric Keypad (No Android Soft Keyboard) -->
    <GridLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:columnCount="3"
        android:rowCount="4"
        android:layout_gravity="center_horizontal"
        android:alignmentMode="alignMargins">

        <!-- Row 1: 1, 2, 3 -->
        <Button
            android:id="@+id/btn_num_1"
            style="@style/Widget.AppCompat.Button.Borderless"
            android:layout_width="72dp"
            android:layout_height="52dp"
            android:layout_margin="4dp"
            android:background="@drawable/bg_melody_pill"
            android:text="1"
            android:textColor="#831843"
            android:textSize="22sp"
            android:textStyle="bold" />

        <Button
            android:id="@+id/btn_num_2"
            style="@style/Widget.AppCompat.Button.Borderless"
            android:layout_width="72dp"
            android:layout_height="52dp"
            android:layout_margin="4dp"
            android:background="@drawable/bg_melody_pill"
            android:text="2"
            android:textColor="#831843"
            android:textSize="22sp"
            android:textStyle="bold" />

        <Button
            android:id="@+id/btn_num_3"
            style="@style/Widget.AppCompat.Button.Borderless"
            android:layout_width="72dp"
            android:layout_height="52dp"
            android:layout_margin="4dp"
            android:background="@drawable/bg_melody_pill"
            android:text="3"
            android:textColor="#831843"
            android:textSize="22sp"
            android:textStyle="bold" />

        <!-- Row 2: 4, 5, 6 -->
        <Button
            android:id="@+id/btn_num_4"
            style="@style/Widget.AppCompat.Button.Borderless"
            android:layout_width="72dp"
            android:layout_height="52dp"
            android:layout_margin="4dp"
            android:background="@drawable/bg_melody_pill"
            android:text="4"
            android:textColor="#831843"
            android:textSize="22sp"
            android:textStyle="bold" />

        <Button
            android:id="@+id/btn_num_5"
            style="@style/Widget.AppCompat.Button.Borderless"
            android:layout_width="72dp"
            android:layout_height="52dp"
            android:layout_margin="4dp"
            android:background="@drawable/bg_melody_pill"
            android:text="5"
            android:textColor="#831843"
            android:textSize="22sp"
            android:textStyle="bold" />

        <Button
            android:id="@+id/btn_num_6"
            style="@style/Widget.AppCompat.Button.Borderless"
            android:layout_width="72dp"
            android:layout_height="52dp"
            android:layout_margin="4dp"
            android:background="@drawable/bg_melody_pill"
            android:text="6"
            android:textColor="#831843"
            android:textSize="22sp"
            android:textStyle="bold" />

        <!-- Row 3: 7, 8, 9 -->
        <Button
            android:id="@+id/btn_num_7"
            style="@style/Widget.AppCompat.Button.Borderless"
            android:layout_width="72dp"
            android:layout_height="52dp"
            android:layout_margin="4dp"
            android:background="@drawable/bg_melody_pill"
            android:text="7"
            android:textColor="#831843"
            android:textSize="22sp"
            android:textStyle="bold" />

        <Button
            android:id="@+id/btn_num_8"
            style="@style/Widget.AppCompat.Button.Borderless"
            android:layout_width="72dp"
            android:layout_height="52dp"
            android:layout_margin="4dp"
            android:background="@drawable/bg_melody_pill"
            android:text="8"
            android:textColor="#831843"
            android:textSize="22sp"
            android:textStyle="bold" />

        <Button
            android:id="@+id/btn_num_9"
            style="@style/Widget.AppCompat.Button.Borderless"
            android:layout_width="72dp"
            android:layout_height="52dp"
            android:layout_margin="4dp"
            android:background="@drawable/bg_melody_pill"
            android:text="9"
            android:textColor="#831843"
            android:textSize="22sp"
            android:textStyle="bold" />

        <!-- Row 4: Clear, 0, Backspace -->
        <Button
            android:id="@+id/btn_num_clear"
            style="@style/Widget.AppCompat.Button.Borderless"
            android:layout_width="72dp"
            android:layout_height="52dp"
            android:layout_margin="4dp"
            android:background="@drawable/bg_melody_pill"
            android:text="C"
            android:textColor="#E11D48"
            android:textSize="18sp"
            android:textStyle="bold" />

        <Button
            android:id="@+id/btn_num_0"
            style="@style/Widget.AppCompat.Button.Borderless"
            android:layout_width="72dp"
            android:layout_height="52dp"
            android:layout_margin="4dp"
            android:background="@drawable/bg_melody_pill"
            android:text="0"
            android:textColor="#831843"
            android:textSize="22sp"
            android:textStyle="bold" />

        <Button
            android:id="@+id/btn_num_backspace"
            style="@style/Widget.AppCompat.Button.Borderless"
            android:layout_width="72dp"
            android:layout_height="52dp"
            android:layout_margin="4dp"
            android:background="@drawable/bg_melody_pill"
            android:text="⌫"
            android:textColor="#831843"
            android:textSize="20sp"
            android:textStyle="bold" />

    </GridLayout>

    <!-- Cancel button -->
    <Button
        android:id="@+id/btn_pinpad_cancel"
        android:layout_width="wrap_content"
        android:layout_height="38dp"
        android:layout_marginTop="12dp"
        android:text="Cancel"
        android:textColor="#9D174D"
        android:textSize="13sp"
        android:background="@drawable/bg_melody_chip_unselected"
        android:paddingHorizontal="24dp" />

</LinearLayout>
