<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_melody_sky">

    <!-- Top Header Bar -->
    <LinearLayout
        android:id="@+id/layout_files_header"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingHorizontal="16dp"
        android:paddingVertical="10dp"
        android:background="#66FFFFFF"
        android:layout_alignParentTop="true">

        <TextView
            android:id="@+id/btn_files_back"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="◀ Back"
            android:textColor="#FFFFFF"
            android:textSize="14sp"
            android:textStyle="bold"
            android:background="@drawable/bg_melody_chip_selected"
            android:paddingHorizontal="14dp"
            android:paddingVertical="6dp"
            android:clickable="true"
            android:focusable="true" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="🌸 File Manager 📁"
            android:textColor="#831843"
            android:textSize="18sp"
            android:textStyle="bold"
            android:gravity="center" />

        <TextView
            android:id="@+id/btn_files_refresh"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="🔄 Refresh"
            android:textColor="#831843"
            android:textSize="12sp"
            android:textStyle="bold"
            android:background="@drawable/bg_melody_pill"
            android:paddingHorizontal="12dp"
            android:paddingVertical="6dp"
            android:clickable="true"
            android:focusable="true" />
    </LinearLayout>

    <!-- Main Container Card -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:layout_below="@id/layout_files_header"
        android:padding="12dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:background="@drawable/bg_melody_card"
            android:padding="14dp">

            <!-- Storage Info Banner & Search Row -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginBottom="10dp">

                <TextView
                    android:id="@+id/tv_storage_summary"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="💾 Internal Storage • Calculating..."
                    android:textColor="#831843"
                    android:textSize="13sp"
                    android:textStyle="bold" />

                <!-- Search Input -->
                <EditText
                    android:id="@+id/et_search_files"
                    android:layout_width="220dp"
                    android:layout_height="36dp"
                    android:background="@drawable/bg_melody_pill"
                    android:hint="🔍 Filter files..."
                    android:textColor="#831843"
                    android:textColorHint="#9D174D"
                    android:textSize="12sp"
                    android:paddingHorizontal="12dp"
                    android:singleLine="true" />
            </LinearLayout>

            <!-- Quick Category Filter Chips -->
            <HorizontalScrollView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:scrollbars="none"
                android:layout_marginBottom="10dp">

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/chip_cat_all"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="📁 Internal Storage"
                        android:textColor="#FFFFFF"
                        android:textSize="12sp"
                        android:textStyle="bold"
                        android:background="@drawable/bg_melody_chip_selected"
                        android:paddingHorizontal="12dp"
                        android:paddingVertical="6dp"
                        android:layout_marginEnd="6dp"
                        android:clickable="true"
                        android:focusable="true" />

                    <TextView
                        android:id="@+id/chip_cat_downloads"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="📥 Downloads"
                        android:textColor="#831843"
                        android:textSize="12sp"
                        android:textStyle="bold"
                        android:background="@drawable/bg_melody_chip_unselected"
                        android:paddingHorizontal="12dp"
                        android:paddingVertical="6dp"
                        android:layout_marginEnd="6dp"
                        android:clickable="true"
                        android:focusable="true" />

                    <TextView
                        android:id="@+id/chip_cat_pictures"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="📸 Pictures"
                        android:textColor="#831843"
                        android:textSize="12sp"
                        android:textStyle="bold"
                        android:background="@drawable/bg_melody_chip_unselected"
                        android:paddingHorizontal="12dp"
                        android:paddingVertical="6dp"
                        android:layout_marginEnd="6dp"
                        android:clickable="true"
                        android:focusable="true" />

                    <TextView
                        android:id="@+id/chip_cat_music"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="🎵 Music"
                        android:textColor="#831843"
                        android:textSize="12sp"
                        android:textStyle="bold"
                        android:background="@drawable/bg_melody_chip_unselected"
                        android:paddingHorizontal="12dp"
                        android:paddingVertical="6dp"
                        android:layout_marginEnd="6dp"
                        android:clickable="true"
                        android:focusable="true" />

                    <TextView
                        android:id="@+id/chip_cat_videos"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="🎬 Videos"
                        android:textColor="#831843"
                        android:textSize="12sp"
                        android:textStyle="bold"
                        android:background="@drawable/bg_melody_chip_unselected"
                        android:paddingHorizontal="12dp"
                        android:paddingVertical="6dp"
                        android:layout_marginEnd="6dp"
                        android:clickable="true"
                        android:focusable="true" />

                    <TextView
                        android:id="@+id/chip_cat_docs"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="📄 Documents"
                        android:textColor="#831843"
                        android:textSize="12sp"
                        android:textStyle="bold"
                        android:background="@drawable/bg_melody_chip_unselected"
                        android:paddingHorizontal="12dp"
                        android:paddingVertical="6dp"
                        android:clickable="true"
                        android:focusable="true" />
                </LinearLayout>
            </HorizontalScrollView>

            <!-- Breadcrumb Navigation & Up Button -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:background="@drawable/bg_melody_pill"
                android:paddingHorizontal="10dp"
                android:paddingVertical="6dp"
                android:layout_marginBottom="8dp">

                <TextView
                    android:id="@+id/btn_folder_up"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="⬆ Up"
                    android:textColor="#DB2777"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    android:background="@drawable/bg_melody_card"
                    android:paddingHorizontal="10dp"
                    android:paddingVertical="4dp"
                    android:layout_marginEnd="8dp"
                    android:clickable="true"
                    android:focusable="true" />

                <TextView
                    android:id="@+id/tv_current_path"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="/sdcard"
                    android:textColor="#831843"
                    android:textSize="12sp"
                    android:singleLine="true"
                    android:ellipsize="start" />

                <TextView
                    android:id="@+id/tv_items_count"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="0 items"
                    android:textColor="#9D174D"
                    android:textSize="11sp" />
            </LinearLayout>

            <!-- Empty Folder State -->
            <LinearLayout
                android:id="@+id/layout_empty_folder"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:orientation="vertical"
                android:gravity="center"
                android:visibility="gone">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="📂✨"
                    android:textSize="44sp"
                    android:layout_marginBottom="8dp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="This folder is empty"
                    android:textColor="#831843"
                    android:textSize="15sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="No files or folders found here 🌸"
                    android:textColor="#9D174D"
                    android:textSize="12sp" />
            </LinearLayout>

            <!-- Files RecyclerView -->
            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rv_files_list"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:scrollbars="vertical" />

        </LinearLayout>
    </LinearLayout>

</RelativeLayout>
