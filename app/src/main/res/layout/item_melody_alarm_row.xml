<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:gravity="center_vertical"
    android:background="@drawable/bg_melody_pill"
    android:paddingHorizontal="12dp"
    android:paddingVertical="8dp"
    android:layout_marginBottom="8dp">

    <!-- Left: Time -->
    <TextView
        android:id="@+id/tv_item_alarm_time"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="07:00 AM"
        android:textColor="#831843"
        android:textSize="20sp"
        android:textStyle="bold" />

    <!-- Center: Label + Sound -->
    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical"
        android:layout_marginStart="12dp">

        <TextView
            android:id="@+id/tv_item_alarm_label"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Wake Up ☀️"
            android:textColor="#9D174D"
            android:textSize="13sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tv_item_alarm_sound"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="🎵 🌸 Sweet Melody"
            android:textColor="#BE185D"
            android:textSize="11sp" />
    </LinearLayout>

    <!-- Toggle ON/OFF Button -->
    <TextView
        android:id="@+id/btn_item_alarm_toggle"
        android:layout_width="56dp"
        android:layout_height="28dp"
        android:text="ON"
        android:textColor="#FFFFFF"
        android:textSize="12sp"
        android:textStyle="bold"
        android:background="@drawable/bg_melody_chip_selected"
        android:gravity="center"
        android:clickable="true"
        android:focusable="true"
        android:layout_marginEnd="8dp" />

    <!-- Delete Button -->
    <TextView
        android:id="@+id/btn_item_alarm_delete"
        android:layout_width="32dp"
        android:layout_height="28dp"
        android:text="🗑️"
        android:textSize="14sp"
        android:gravity="center"
        android:clickable="true"
        android:focusable="true" />

</LinearLayout>
