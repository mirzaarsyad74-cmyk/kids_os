<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#000000">

    <!-- Camera Hardware Preview -->
    <SurfaceView
        android:id="@+id/camera_surface_view"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_centerInParent="true" />

    <!-- Cute My Melody Frame & Stickers Overlay -->
    <com.kids.launcher.MelodyFrameOverlayView
        android:id="@+id/melody_frame_overlay"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <!-- Top Header Controls -->
    <LinearLayout
        android:id="@+id/layout_camera_header"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:padding="12dp"
        android:background="#66000000"
        android:layout_alignParentTop="true">

        <TextView
            android:id="@+id/btn_camera_back"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="◀ Back"
            android:textColor="#FFFFFF"
            android:textSize="14sp"
            android:textStyle="bold"
            android:background="@drawable/bg_melody_pill"
            android:paddingHorizontal="14dp"
            android:paddingVertical="6dp"
            android:clickable="true"
            android:focusable="true" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="🌸 Melody Sparkle Camera ✨"
            android:textColor="#FFFFFF"
            android:textSize="16sp"
            android:textStyle="bold"
            android:gravity="center"
            android:shadowColor="#FF4D8D"
            android:shadowDx="0"
            android:shadowDy="0"
            android:shadowRadius="10" />

        <TextView
            android:id="@+id/btn_camera_flash"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="⚡ Auto"
            android:textColor="#831843"
            android:textSize="13sp"
            android:textStyle="bold"
            android:background="@drawable/bg_melody_pill"
            android:paddingHorizontal="12dp"
            android:paddingVertical="6dp"
            android:layout_marginEnd="8dp"
            android:clickable="true"
            android:focusable="true" />

        <TextView
            android:id="@+id/btn_camera_flip"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="🔄 Flip"
            android:textColor="#831843"
            android:textSize="13sp"
            android:textStyle="bold"
            android:background="@drawable/bg_melody_pill"
            android:paddingHorizontal="12dp"
            android:paddingVertical="6dp"
            android:clickable="true"
            android:focusable="true" />
    </LinearLayout>

    <!-- Bottom Controls & Frame Selector -->
    <LinearLayout
        android:id="@+id/layout_camera_bottom"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center"
        android:paddingBottom="8dp"
        android:paddingTop="6dp"
        android:layout_marginBottom="0dp"
        android:background="#66000000"
        android:layout_alignParentBottom="true">

        <!-- Frame Selector Chips -->
        <HorizontalScrollView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:scrollbars="none"
            android:layout_marginBottom="10dp">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:paddingHorizontal="16dp">

                <TextView
                    android:id="@+id/chip_frame_none"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="🚫 No Filter"
                    android:textColor="#831843"
                    android:textSize="13sp"
                    android:textStyle="bold"
                    android:background="@drawable/bg_melody_chip_unselected"
                    android:paddingHorizontal="12dp"
                    android:paddingVertical="6dp"
                    android:layout_marginEnd="8dp"
                    android:clickable="true"
                    android:focusable="true" />

                <TextView
                    android:id="@+id/chip_frame_melody"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="🐰 Melody Ears"
                    android:textColor="#FFFFFF"
                    android:textSize="13sp"
                    android:textStyle="bold"
                    android:background="@drawable/bg_melody_chip_selected"
                    android:paddingHorizontal="12dp"
                    android:paddingVertical="6dp"
                    android:layout_marginEnd="8dp"
                    android:clickable="true"
                    android:focusable="true" />

                <TextView
                    android:id="@+id/chip_frame_sparkles"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="✨ Stars &amp; Glow"
                    android:textColor="#831843"
                    android:textSize="13sp"
                    android:textStyle="bold"
                    android:background="@drawable/bg_melody_chip_unselected"
                    android:paddingHorizontal="12dp"
                    android:paddingVertical="6dp"
                    android:layout_marginEnd="8dp"
                    android:clickable="true"
                    android:focusable="true" />

                <TextView
                    android:id="@+id/chip_frame_berry"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="🍓 Strawberries"
                    android:textColor="#831843"
                    android:textSize="13sp"
                    android:textStyle="bold"
                    android:background="@drawable/bg_melody_chip_unselected"
                    android:paddingHorizontal="12dp"
                    android:paddingVertical="6dp"
                    android:layout_marginEnd="8dp"
                    android:clickable="true"
                    android:focusable="true" />

                <TextView
                    android:id="@+id/chip_frame_hearts"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="💖 Heart Clouds"
                    android:textColor="#831843"
                    android:textSize="13sp"
                    android:textStyle="bold"
                    android:background="@drawable/bg_melody_chip_unselected"
                    android:paddingHorizontal="12dp"
                    android:paddingVertical="6dp"
                    android:layout_marginEnd="8dp"
                    android:clickable="true"
                    android:focusable="true" />

                <TextView
                    android:id="@+id/chip_frame_polaroid"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="📸 Polaroid"
                    android:textColor="#831843"
                    android:textSize="13sp"
                    android:textStyle="bold"
                    android:background="@drawable/bg_melody_chip_unselected"
                    android:paddingHorizontal="12dp"
                    android:paddingVertical="6dp"
                    android:clickable="true"
                    android:focusable="true" />
            </LinearLayout>
        </HorizontalScrollView>

        <!-- Shutter Button -->
        <FrameLayout
            android:id="@+id/btn_camera_shutter"
            android:layout_width="74dp"
            android:layout_height="74dp"
            android:background="@drawable/bg_camera_shutter"
            android:clickable="true"
            android:focusable="true">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:text="📸"
                android:textSize="26sp" />
        </FrameLayout>
    </LinearLayout>

    <!-- White Flash Animation View -->
    <View
        android:id="@+id/view_shutter_flash"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#FFFFFF"
        android:visibility="gone" />

    <!-- Instant Photo Preview Popup Modal -->
    <RelativeLayout
        android:id="@+id/layout_photo_preview_modal"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#D9000000"
        android:gravity="center"
        android:padding="20dp"
        android:visibility="gone">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="center_horizontal"
            android:background="@drawable/bg_melody_card"
            android:padding="16dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="✨ Photo Saved to Gallery! 🌸"
                android:textColor="#831843"
                android:textSize="16sp"
                android:textStyle="bold"
                android:layout_marginBottom="10dp" />

            <ImageView
                android:id="@+id/iv_captured_photo_preview"
                android:layout_width="320dp"
                android:layout_height="220dp"
                android:scaleType="fitCenter"
                android:background="#FFE4E6"
                android:layout_marginBottom="14dp" />

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/btn_preview_take_more"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="📸 Take More"
                    android:textColor="#FFFFFF"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    android:background="@drawable/bg_melody_chip_selected"
                    android:paddingHorizontal="20dp"
                    android:paddingVertical="8dp"
                    android:clickable="true"
                    android:focusable="true" />
            </LinearLayout>
        </LinearLayout>
    </RelativeLayout>

</RelativeLayout>
