<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/card_share_file_root"
    android:layout_width="match_parent"
    android:layout_height="105dp"
    android:layout_margin="5dp"
    android:background="@drawable/bg_melody_card"
    android:clickable="true"
    android:focusable="true">

    <!-- Media Thumbnail Preview -->
    <ImageView
        android:id="@+id/iv_share_file_thumb"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scaleType="centerCrop" />

    <!-- Fallback Category Icon (e.g. for Audio/Songs) -->
    <TextView
        android:id="@+id/tv_share_file_icon"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:gravity="center"
        android:text="🎵"
        android:textSize="36sp"
        android:visibility="gone" />

    <!-- Bottom Gradient File Title & Tag -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:orientation="vertical"
        android:background="#B3000000"
        android:paddingHorizontal="6dp"
        android:paddingVertical="4dp">

        <TextView
            android:id="@+id/tv_share_file_name"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Artwork.png"
            android:textColor="#FFFFFF"
            android:textSize="10sp"
            android:textStyle="bold"
            android:singleLine="true"
            android:ellipsize="middle" />
    </LinearLayout>

    <!-- Google Stitch Kawaii Checkmark Pill Badge -->
    <FrameLayout
        android:id="@+id/tv_share_file_selected"
        android:layout_width="26dp"
        android:layout_height="26dp"
        android:layout_gravity="top|end"
        android:layout_margin="6dp"
        android:background="@drawable/bg_avatar_circle"
        android:visibility="gone">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="center"
            android:text="✓"
            android:textColor="#FFFFFF"
            android:textSize="13sp"
            android:textStyle="bold" />
    </FrameLayout>

</FrameLayout>
