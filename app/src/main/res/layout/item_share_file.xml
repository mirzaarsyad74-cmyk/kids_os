<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/card_share_file_root"
    android:layout_width="match_parent"
    android:layout_height="100dp"
    android:layout_margin="4dp"
    android:background="@drawable/bg_melody_card"
    android:clickable="true"
    android:focusable="true">

    <ImageView
        android:id="@+id/iv_share_file_thumb"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scaleType="centerCrop" />

    <TextView
        android:id="@+id/tv_share_file_icon"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:gravity="center"
        android:text="📄"
        android:textSize="32sp"
        android:visibility="gone" />

    <!-- File Title Bar at bottom -->
    <TextView
        android:id="@+id/tv_share_file_name"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:background="#99000000"
        android:padding="4dp"
        android:text="File.png"
        android:textColor="#FFFFFF"
        android:textSize="9sp"
        android:singleLine="true"
        android:ellipsize="middle" />

    <!-- Selection Checkmark Indicator -->
    <TextView
        android:id="@+id/tv_share_file_selected"
        android:layout_width="24dp"
        android:layout_height="24dp"
        android:layout_gravity="top|end"
        android:layout_margin="4dp"
        android:gravity="center"
        android:background="@drawable/bg_avatar_circle"
        android:text="✓"
        android:textColor="#FFFFFF"
        android:textSize="12sp"
        android:textStyle="bold"
        android:visibility="gone" />

</FrameLayout>
