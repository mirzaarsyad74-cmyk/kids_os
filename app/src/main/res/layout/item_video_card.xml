<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/card_video_root"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@drawable/bg_melody_card"
    android:padding="8dp"
    android:layout_margin="6dp"
    android:clickable="true"
    android:focusable="true">

    <!-- Video Thumbnail with Duration Badge & Play Icon -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="120dp"
        android:background="#1E1015">

        <ImageView
            android:id="@+id/iv_video_thumb"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:scaleType="centerCrop" />

        <!-- Center Play Badge -->
        <TextView
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_gravity="center"
            android:gravity="center"
            android:background="@drawable/bg_avatar_circle"
            android:text="▶"
            android:textColor="#FFFFFF"
            android:textSize="18sp" />

        <!-- Duration Badge at bottom right -->
        <TextView
            android:id="@+id/tv_video_duration_badge"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="bottom|end"
            android:layout_margin="6dp"
            android:text="00:00"
            android:textColor="#FFFFFF"
            android:textSize="10sp"
            android:textStyle="bold"
            android:background="#CC000000"
            android:paddingHorizontal="6dp"
            android:paddingVertical="2dp" />
    </FrameLayout>

    <!-- Video Title & Meta -->
    <TextView
        android:id="@+id/tv_video_title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Video Title.mp4"
        android:textColor="#831843"
        android:textSize="12sp"
        android:textStyle="bold"
        android:singleLine="true"
        android:ellipsize="middle"
        android:layout_marginTop="6dp" />

    <TextView
        android:id="@+id/tv_video_size"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="45.2 MB • Sep 23, 2026"
        android:textColor="#9D174D"
        android:textSize="10sp"
        android:singleLine="true" />

</LinearLayout>
