<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/touch_menu_overlay_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#66000000"
    android:clickable="true"
    android:focusable="true">

    <!-- Centered AssistiveTouch Floating Modal Card -->
    <LinearLayout
        android:id="@+id/layout_touch_menu_card"
        android:layout_width="320dp"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:orientation="vertical"
        android:background="@drawable/bg_melody_card"
        android:padding="16dp"
        android:elevation="40dp"
        android:clickable="true"
        android:focusable="false">

        <!-- Title / Header with close button -->
        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="12dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_centerVertical="true"
                android:text="🌸 Melody Touch 🎀"
                android:textColor="#831843"
                android:textSize="16sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/btn_close_touch_menu"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:layout_alignParentEnd="true"
                android:layout_centerVertical="true"
                android:background="@drawable/bg_melody_pill"
                android:text="✕"
                android:textColor="#831843"
                android:textSize="14sp"
                android:textStyle="bold"
                android:gravity="center"
                android:clickable="true"
                android:focusable="true" />
        </RelativeLayout>

        <!-- 8 Action Buttons Grid (4 x 2) -->
        <GridLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:columnCount="4"
            android:alignmentMode="alignMargins"
            android:useDefaultMargins="true">

            <!-- 1. Back -->
            <LinearLayout
                android:id="@+id/btn_action_back"
                android:layout_width="64dp"
                android:layout_height="64dp"
                android:orientation="vertical"
                android:gravity="center"
                android:background="@drawable/bg_melody_pill"
                android:clickable="true"
                android:focusable="true">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="◀"
                    android:textColor="#831843"
                    android:textSize="18sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Back"
                    android:textColor="#831843"
                    android:textSize="10sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <!-- 2. Home -->
            <LinearLayout
                android:id="@+id/btn_action_home"
                android:layout_width="64dp"
                android:layout_height="64dp"
                android:orientation="vertical"
                android:gravity="center"
                android:background="@drawable/bg_melody_pill"
                android:clickable="true"
                android:focusable="true">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="🏠"
                    android:textSize="18sp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Home"
                    android:textColor="#831843"
                    android:textSize="10sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <!-- 3. Recents -->
            <LinearLayout
                android:id="@+id/btn_action_recents"
                android:layout_width="64dp"
                android:layout_height="64dp"
                android:orientation="vertical"
                android:gravity="center"
                android:background="@drawable/bg_melody_pill"
                android:clickable="true"
                android:focusable="true">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="🗂️"
                    android:textSize="18sp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Recents"
                    android:textColor="#831843"
                    android:textSize="10sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <!-- 4. Screenshot -->
            <LinearLayout
                android:id="@+id/btn_action_screenshot"
                android:layout_width="64dp"
                android:layout_height="64dp"
                android:orientation="vertical"
                android:gravity="center"
                android:background="@drawable/bg_melody_pill"
                android:clickable="true"
                android:focusable="true">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="📸"
                    android:textSize="18sp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Capture"
                    android:textColor="#831843"
                    android:textSize="10sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <!-- 5. Vol Up -->
            <LinearLayout
                android:id="@+id/btn_action_vol_up"
                android:layout_width="64dp"
                android:layout_height="64dp"
                android:orientation="vertical"
                android:gravity="center"
                android:background="@drawable/bg_melody_pill"
                android:clickable="true"
                android:focusable="true">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="🔊"
                    android:textSize="18sp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Vol +"
                    android:textColor="#831843"
                    android:textSize="10sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <!-- 6. Vol Down -->
            <LinearLayout
                android:id="@+id/btn_action_vol_down"
                android:layout_width="64dp"
                android:layout_height="64dp"
                android:orientation="vertical"
                android:gravity="center"
                android:background="@drawable/bg_melody_pill"
                android:clickable="true"
                android:focusable="true">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="🔉"
                    android:textSize="18sp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Vol -"
                    android:textColor="#831843"
                    android:textSize="10sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <!-- 7. WiFi Toggle -->
            <LinearLayout
                android:id="@+id/btn_action_wifi"
                android:layout_width="64dp"
                android:layout_height="64dp"
                android:orientation="vertical"
                android:gravity="center"
                android:background="@drawable/bg_melody_pill"
                android:clickable="true"
                android:focusable="true">

                <TextView
                    android:id="@+id/tv_action_wifi_icon"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="📶"
                    android:textSize="18sp" />

                <TextView
                    android:id="@+id/tv_action_wifi_label"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="WiFi ON"
                    android:textColor="#831843"
                    android:textSize="10sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <!-- 8. Boost -->
            <LinearLayout
                android:id="@+id/btn_action_boost"
                android:layout_width="64dp"
                android:layout_height="64dp"
                android:orientation="vertical"
                android:gravity="center"
                android:background="@drawable/bg_melody_pill"
                android:clickable="true"
                android:focusable="true">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="🚀"
                    android:textSize="18sp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Boost"
                    android:textColor="#831843"
                    android:textSize="10sp"
                    android:textStyle="bold" />
            </LinearLayout>

        </GridLayout>

        <!-- Mini Music Controller Bar for Apple ID Assistant -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:orientation="vertical"
            android:background="@drawable/bg_melody_pill"
            android:padding="8dp">

            <!-- Song Info Row -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginBottom="6dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="🎵 "
                    android:textSize="13sp" />

                <TextView
                    android:id="@+id/tv_touch_music_info"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="🌸 1. Melody Dreamland"
                    android:textColor="#831843"
                    android:textSize="11sp"
                    android:textStyle="bold"
                    android:singleLine="true"
                    android:ellipsize="marquee"
                    android:marqueeRepeatLimit="marquee_forever" />

                <TextView
                    android:id="@+id/tv_touch_music_status"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Paused"
                    android:textColor="#DB2777"
                    android:textSize="10sp"
                    android:textStyle="bold"
                    android:layout_marginStart="4dp" />
            </LinearLayout>

            <!-- Controls Row: Prev, Play/Pause, Next -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center">

                <!-- Previous -->
                <TextView
                    android:id="@+id/btn_touch_music_prev"
                    android:layout_width="54dp"
                    android:layout_height="36dp"
                    android:gravity="center"
                    android:background="@drawable/bg_melody_card"
                    android:text="⏮"
                    android:textColor="#831843"
                    android:textSize="16sp"
                    android:clickable="true"
                    android:focusable="true"
                    android:layout_marginEnd="10dp" />

                <!-- Play / Pause -->
                <TextView
                    android:id="@+id/btn_touch_music_play_pause"
                    android:layout_width="72dp"
                    android:layout_height="36dp"
                    android:gravity="center"
                    android:background="@drawable/bg_melody_card"
                    android:text="▶"
                    android:textColor="#831843"
                    android:textSize="18sp"
                    android:textStyle="bold"
                    android:clickable="true"
                    android:focusable="true" />

                <!-- Next -->
                <TextView
                    android:id="@+id/btn_touch_music_next"
                    android:layout_width="54dp"
                    android:layout_height="36dp"
                    android:gravity="center"
                    android:background="@drawable/bg_melody_card"
                    android:text="⏭"
                    android:textColor="#831843"
                    android:textSize="16sp"
                    android:clickable="true"
                    android:focusable="true"
                    android:layout_marginStart="10dp" />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>

</FrameLayout>
