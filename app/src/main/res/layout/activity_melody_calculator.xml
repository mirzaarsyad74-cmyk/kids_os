<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@drawable/bg_melody_card"
    android:padding="12dp">

    <!-- Top Header Bar -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingHorizontal="8dp">

        <TextView
            android:id="@+id/btn_calc_back"
            android:layout_width="wrap_content"
            android:layout_height="34dp"
            android:text="◀ Back"
            android:textColor="#831843"
            android:textSize="13sp"
            android:textStyle="bold"
            android:background="@drawable/bg_melody_pill"
            android:paddingHorizontal="14dp"
            android:gravity="center"
            android:clickable="true"
            android:focusable="true" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="🌸 Melody Calculator 🔢"
            android:textColor="#831843"
            android:textSize="16sp"
            android:textStyle="bold"
            android:gravity="center" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="🎀 Sweet Math ✨"
            android:textColor="#9D174D"
            android:textSize="12sp"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- Calculator Main Layout (2 Columns in Landscape) -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="horizontal"
        android:layout_marginTop="6dp">

        <!-- Left Column: Display Screen & History -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="0.8"
            android:orientation="vertical"
            android:background="@drawable/bg_melody_nav_button"
            android:padding="16dp"
            android:layout_marginEnd="10dp"
            android:gravity="bottom">

            <TextView
                android:id="@+id/tv_calc_history"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text=""
                android:textColor="#9D174D"
                android:textSize="16sp"
                android:gravity="end"
                android:maxLines="2"
                android:ellipsize="start"
                android:layout_marginBottom="8dp" />

            <TextView
                android:id="@+id/tv_calc_result"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="0"
                android:textColor="#831843"
                android:textSize="36sp"
                android:textStyle="bold"
                android:gravity="end"
                android:singleLine="true" />

            <TextView
                android:id="@+id/tv_calc_sparkle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="✨🌸 Keep Learning! 🌸✨"
                android:textColor="#BE185D"
                android:textSize="12sp"
                android:layout_gravity="start"
                android:layout_marginTop="12dp" />
        </LinearLayout>

        <!-- Right Column: Keypad Grid -->
        <GridLayout
            android:id="@+id/grid_calculator"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1.2"
            android:columnCount="4"
            android:rowCount="5"
            android:useDefaultMargins="true"
            android:alignmentMode="alignMargins">

            <!-- Row 1: AC, ⌫, %, ÷ -->
            <TextView
                android:id="@+id/btn_calc_clear"
                style="@style/MelodyCalcBtnOperator"
                android:text="AC"
                android:textColor="#BE123C" />
            <TextView
                android:id="@+id/btn_calc_backspace"
                style="@style/MelodyCalcBtnOperator"
                android:text="⌫" />
            <TextView
                android:id="@+id/btn_calc_percent"
                style="@style/MelodyCalcBtnOperator"
                android:text="%" />
            <TextView
                android:id="@+id/btn_calc_div"
                style="@style/MelodyCalcBtnOperator"
                android:text="÷" />

            <!-- Row 2: 7, 8, 9, × -->
            <TextView
                android:id="@+id/btn_calc_7"
                style="@style/MelodyCalcBtnNumber"
                android:text="7" />
            <TextView
                android:id="@+id/btn_calc_8"
                style="@style/MelodyCalcBtnNumber"
                android:text="8" />
            <TextView
                android:id="@+id/btn_calc_9"
                style="@style/MelodyCalcBtnNumber"
                android:text="9" />
            <TextView
                android:id="@+id/btn_calc_mul"
                style="@style/MelodyCalcBtnOperator"
                android:text="×" />

            <!-- Row 3: 4, 5, 6, - -->
            <TextView
                android:id="@+id/btn_calc_4"
                style="@style/MelodyCalcBtnNumber"
                android:text="4" />
            <TextView
                android:id="@+id/btn_calc_5"
                style="@style/MelodyCalcBtnNumber"
                android:text="5" />
            <TextView
                android:id="@+id/btn_calc_6"
                style="@style/MelodyCalcBtnNumber"
                android:text="6" />
            <TextView
                android:id="@+id/btn_calc_sub"
                style="@style/MelodyCalcBtnOperator"
                android:text="-" />

            <!-- Row 4: 1, 2, 3, + -->
            <TextView
                android:id="@+id/btn_calc_1"
                style="@style/MelodyCalcBtnNumber"
                android:text="1" />
            <TextView
                android:id="@+id/btn_calc_2"
                style="@style/MelodyCalcBtnNumber"
                android:text="2" />
            <TextView
                android:id="@+id/btn_calc_3"
                style="@style/MelodyCalcBtnNumber"
                android:text="3" />
            <TextView
                android:id="@+id/btn_calc_add"
                style="@style/MelodyCalcBtnOperator"
                android:text="+" />

            <!-- Row 5: ❤️, 0, ., = -->
            <TextView
                android:id="@+id/btn_calc_heart"
                style="@style/MelodyCalcBtnNumber"
                android:text="❤️"
                android:textSize="18sp" />
            <TextView
                android:id="@+id/btn_calc_0"
                style="@style/MelodyCalcBtnNumber"
                android:text="0" />
            <TextView
                android:id="@+id/btn_calc_dot"
                style="@style/MelodyCalcBtnNumber"
                android:text="." />
            <TextView
                android:id="@+id/btn_calc_equals"
                style="@style/MelodyCalcBtnEquals"
                android:text="=" />

        </GridLayout>
    </LinearLayout>

</LinearLayout>
