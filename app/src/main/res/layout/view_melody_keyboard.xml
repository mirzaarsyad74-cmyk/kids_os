<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/layout_keyboard_root"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="#FFF5F8"
    android:paddingTop="4dp"
    android:paddingBottom="6dp"
    android:paddingHorizontal="4dp"
    android:elevation="12dp">

    <!-- Top Suggestion & Quick Sticker Strip -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="40dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:background="#FCE7F3"
        android:paddingHorizontal="6dp"
        android:layout_marginBottom="4dp">

        <HorizontalScrollView
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:scrollbars="none"
            android:overScrollMode="never">

            <LinearLayout
                android:id="@+id/layout_quick_emojis"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:orientation="horizontal"
                android:gravity="center_vertical">
                <!-- Emojis dynamically bound or standard buttons -->
            </LinearLayout>
        </HorizontalScrollView>

        <!-- Hide Keyboard Button -->
        <TextView
            android:id="@+id/btn_hide_keyboard"
            android:layout_width="38dp"
            android:layout_height="32dp"
            android:text="🔽"
            android:textSize="16sp"
            android:gravity="center"
            android:background="@drawable/bg_keyboard_action_key"
            android:clickable="true"
            android:focusable="true" />
    </LinearLayout>

    <!-- Letters Layout (QWERTY) -->
    <LinearLayout
        android:id="@+id/layout_letters"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:visibility="visible">

        <!-- Row 1: Q W E R T Y U I O P -->
        <LinearLayout
            android:id="@+id/row_letters_1"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:orientation="horizontal"
            android:layout_marginBottom="4dp" />

        <!-- Row 2: A S D F G H J K L -->
        <LinearLayout
            android:id="@+id/row_letters_2"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:orientation="horizontal"
            android:paddingHorizontal="14dp"
            android:layout_marginBottom="4dp" />

        <!-- Row 3: Shift, Z X C V B N M, Backspace -->
        <LinearLayout
            android:id="@+id/row_letters_3"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:orientation="horizontal"
            android:layout_marginBottom="4dp">

            <TextView
                android:id="@+id/btn_shift"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1.4"
                android:text="⇧"
                android:textColor="#831843"
                android:textSize="20sp"
                android:textStyle="bold"
                android:gravity="center"
                android:background="@drawable/bg_keyboard_action_key"
                android:layout_marginEnd="4dp" />

            <LinearLayout
                android:id="@+id/row_letters_3_mid"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="7"
                android:orientation="horizontal" />

            <TextView
                android:id="@+id/btn_backspace"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1.4"
                android:text="⌫"
                android:textColor="#831843"
                android:textSize="20sp"
                android:textStyle="bold"
                android:gravity="center"
                android:background="@drawable/bg_keyboard_action_key"
                android:layout_marginStart="4dp" />
        </LinearLayout>

        <!-- Row 4: ?123, Emoji, Space, Period, Enter -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/btn_toggle_symbols"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1.5"
                android:text="\?123"
                android:textColor="#831843"
                android:textSize="15sp"
                android:textStyle="bold"
                android:gravity="center"
                android:background="@drawable/bg_keyboard_action_key"
                android:layout_marginEnd="4dp" />

            <TextView
                android:id="@+id/btn_toggle_emojis"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1.1"
                android:text="😊"
                android:textSize="18sp"
                android:gravity="center"
                android:background="@drawable/bg_keyboard_action_key"
                android:layout_marginEnd="4dp" />

            <TextView
                android:id="@+id/btn_space"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="4.8"
                android:text="Space"
                android:textColor="#9CA3AF"
                android:textSize="14sp"
                android:gravity="center"
                android:background="@drawable/bg_keyboard_key"
                android:layout_marginEnd="4dp" />

            <TextView
                android:id="@+id/btn_dot"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1.1"
                android:text="."
                android:textColor="#831843"
                android:textSize="22sp"
                android:textStyle="bold"
                android:gravity="center"
                android:background="@drawable/bg_keyboard_key"
                android:layout_marginEnd="4dp" />

            <TextView
                android:id="@+id/btn_enter"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1.6"
                android:text="↵"
                android:textColor="#FFFFFF"
                android:textSize="22sp"
                android:textStyle="bold"
                android:gravity="center"
                android:background="@drawable/bg_keyboard_enter_key" />
        </LinearLayout>
    </LinearLayout>

    <!-- Symbols Layout (?123) -->
    <LinearLayout
        android:id="@+id/layout_symbols"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:visibility="gone">

        <!-- Row 1: Numbers 1-0 -->
        <LinearLayout
            android:id="@+id/row_symbols_1"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:orientation="horizontal"
            android:layout_marginBottom="4dp" />

        <!-- Row 2: @ # $ % & * - + ( ) -->
        <LinearLayout
            android:id="@+id/row_symbols_2"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:orientation="horizontal"
            android:layout_marginBottom="4dp" />

        <!-- Row 3: = \< , / ! ? : ; " ' , Backspace -->
        <LinearLayout
            android:id="@+id/row_symbols_3"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:orientation="horizontal"
            android:layout_marginBottom="4dp">

            <LinearLayout
                android:id="@+id/row_symbols_3_mid"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="8.4"
                android:orientation="horizontal" />

            <TextView
                android:id="@+id/btn_symbols_backspace"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1.6"
                android:text="⌫"
                android:textColor="#831843"
                android:textSize="20sp"
                android:textStyle="bold"
                android:gravity="center"
                android:background="@drawable/bg_keyboard_action_key"
                android:layout_marginStart="4dp" />
        </LinearLayout>

        <!-- Row 4: ABC, Emoji, Space, Period, Enter -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/btn_toggle_abc"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1.5"
                android:text="ABC"
                android:textColor="#831843"
                android:textSize="15sp"
                android:textStyle="bold"
                android:gravity="center"
                android:background="@drawable/bg_keyboard_action_key"
                android:layout_marginEnd="4dp" />

            <TextView
                android:id="@+id/btn_symbols_comma"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1.1"
                android:text=","
                android:textColor="#831843"
                android:textSize="22sp"
                android:textStyle="bold"
                android:gravity="center"
                android:background="@drawable/bg_keyboard_key"
                android:layout_marginEnd="4dp" />

            <TextView
                android:id="@+id/btn_symbols_space"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="4.8"
                android:text="Space"
                android:textColor="#9CA3AF"
                android:textSize="14sp"
                android:gravity="center"
                android:background="@drawable/bg_keyboard_key"
                android:layout_marginEnd="4dp" />

            <TextView
                android:id="@+id/btn_symbols_dot"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1.1"
                android:text="."
                android:textColor="#831843"
                android:textSize="22sp"
                android:textStyle="bold"
                android:gravity="center"
                android:background="@drawable/bg_keyboard_key"
                android:layout_marginEnd="4dp" />

            <TextView
                android:id="@+id/btn_symbols_enter"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1.6"
                android:text="↵"
                android:textColor="#FFFFFF"
                android:textSize="22sp"
                android:textStyle="bold"
                android:gravity="center"
                android:background="@drawable/bg_keyboard_enter_key" />
        </LinearLayout>
    </LinearLayout>

    <!-- Emoji Picker Grid Layout -->
    <LinearLayout
        android:id="@+id/layout_emojis"
        android:layout_width="match_parent"
        android:layout_height="200dp"
        android:orientation="vertical"
        android:visibility="gone">

        <ScrollView
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:overScrollMode="never">

            <GridLayout
                android:id="@+id/grid_emojis"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:columnCount="8"
                android:alignmentMode="alignMargins"
                android:padding="4dp" />
        </ScrollView>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="44dp"
            android:orientation="horizontal"
            android:layout_marginTop="4dp">

            <TextView
                android:id="@+id/btn_emoji_abc"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:text="ABC"
                android:textColor="#831843"
                android:textSize="16sp"
                android:textStyle="bold"
                android:gravity="center"
                android:background="@drawable/bg_keyboard_action_key"
                android:layout_marginEnd="6dp" />

            <TextView
                android:id="@+id/btn_emoji_space"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="2"
                android:text="Space"
                android:textColor="#9CA3AF"
                android:textSize="14sp"
                android:gravity="center"
                android:background="@drawable/bg_keyboard_key"
                android:layout_marginEnd="6dp" />

            <TextView
                android:id="@+id/btn_emoji_backspace"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:text="⌫"
                android:textColor="#831843"
                android:textSize="20sp"
                android:textStyle="bold"
                android:gravity="center"
                android:background="@drawable/bg_keyboard_action_key" />
        </LinearLayout>
    </LinearLayout>

</LinearLayout>
