<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/item_file_root"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:gravity="center_vertical"
    android:background="@drawable/bg_melody_pill"
    android:paddingHorizontal="14dp"
    android:paddingVertical="10dp"
    android:layout_marginBottom="6dp"
    android:clickable="true"
    android:focusable="true">

    <!-- File / Folder Icon -->
    <TextView
        android:id="@+id/tv_file_icon"
        android:layout_width="38dp"
        android:layout_height="38dp"
        android:gravity="center"
        android:background="@drawable/bg_melody_card"
        android:text="📁"
        android:textSize="20sp"
        android:layout_marginEnd="12dp" />

    <!-- File Name & Meta -->
    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/tv_file_name"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Filename.mp4"
            android:textColor="#831843"
            android:textSize="13sp"
            android:textStyle="bold"
            android:singleLine="true"
            android:ellipsize="middle" />

        <TextView
            android:id="@+id/tv_file_details"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="14.2 MB • Sep 23, 2026"
            android:textColor="#9D174D"
            android:textSize="11sp"
            android:singleLine="true"
            android:ellipsize="end" />
    </LinearLayout>

    <!-- Context action button -->
    <TextView
        android:id="@+id/btn_file_action"
        android:layout_width="32dp"
        android:layout_height="32dp"
        android:gravity="center"
        android:text="⋮"
        android:textColor="#831843"
        android:textSize="18sp"
        android:textStyle="bold"
        android:background="@drawable/bg_melody_card"
        android:clickable="true"
        android:focusable="true" />

</LinearLayout>
