<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/layout_global_navbar_root"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">

    <!-- Mini Melody Auto-Hide Handle (shown when navbar is collapsed in external apps) -->
    <LinearLayout
        android:id="@+id/layout_global_nav_handle"
        android:layout_width="72dp"
        android:layout_height="22dp"
        android:layout_gravity="bottom|center_horizontal"
        android:gravity="center"
        android:background="@drawable/bg_melody_nav_handle"
        android:clickable="true"
        android:focusable="true"
        android:visibility="gone"
        android:elevation="35dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="▲ 🎀 ▲"
            android:textColor="#FFFFFF"
            android:textSize="11sp"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- Full My Melody Navigation Bar -->
    <LinearLayout
        android:id="@+id/layout_global_navbar_bar"
        android:layout_width="match_parent"
        android:layout_height="44dp"
        android:layout_gravity="bottom"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:background="@drawable/bg_melody_navbar"
        android:paddingHorizontal="16dp"
        android:elevation="30dp">

        <!-- Back Button -->
        <LinearLayout
            android:id="@+id/btn_global_back"
            android:layout_width="wrap_content"
            android:layout_height="34dp"
            android:orientation="horizontal"
            android:gravity="center"
            android:background="@drawable/bg_melody_nav_button"
            android:paddingHorizontal="14dp"
            android:clickable="true"
            android:focusable="true">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="◀"
                android:textColor="#FF2A85"
                android:textSize="14sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Back"
                android:textColor="#831843"
                android:textSize="12sp"
                android:textStyle="bold"
                android:layout_marginStart="6dp" />
        </LinearLayout>

        <View
            android:layout_width="0dp"
            android:layout_height="1dp"
            android:layout_weight="1" />

        <!-- Home Button (Melody Bow / Home) -->
        <LinearLayout
            android:id="@+id/btn_global_home"
            android:layout_width="wrap_content"
            android:layout_height="36dp"
            android:orientation="horizontal"
            android:gravity="center"
            android:background="@drawable/bg_melody_chip_selected"
            android:paddingHorizontal="24dp"
            android:clickable="true"
            android:focusable="true">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="🎀"
                android:textSize="16sp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Home"
                android:textColor="#FFFFFF"
                android:textSize="13sp"
                android:textStyle="bold"
                android:layout_marginStart="6dp" />
        </LinearLayout>

        <View
            android:layout_width="0dp"
            android:layout_height="1dp"
            android:layout_weight="1" />

        <!-- Recent Windows Button -->
        <LinearLayout
            android:id="@+id/btn_global_recents"
            android:layout_width="wrap_content"
            android:layout_height="34dp"
            android:orientation="horizontal"
            android:gravity="center"
            android:background="@drawable/bg_melody_nav_button"
            android:paddingHorizontal="14dp"
            android:clickable="true"
            android:focusable="true">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="🗂️"
                android:textSize="14sp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Recent"
                android:textColor="#831843"
                android:textSize="12sp"
                android:textStyle="bold"
                android:layout_marginStart="6dp" />
        </LinearLayout>

        <View
            android:layout_width="0dp"
            android:layout_height="1dp"
            android:layout_weight="1" />

        <!-- Global Melody Battery Capsule -->
        <LinearLayout
            android:id="@+id/layout_global_nav_battery"
            android:layout_width="wrap_content"
            android:layout_height="32dp"
            android:orientation="horizontal"
            android:gravity="center"
            android:background="@drawable/bg_melody_pill"
            android:paddingHorizontal="10dp"
            android:clickable="true"
            android:focusable="true">

            <com.kids.launcher.BatteryGaugeView
                android:id="@+id/gauge_global_nav_battery"
                android:layout_width="22dp"
                android:layout_height="14dp"
                android:layout_marginEnd="6dp" />

            <TextView
                android:id="@+id/tv_global_nav_battery_percent"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="100%"
                android:textColor="#831843"
                android:textSize="12sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tv_global_nav_charging_sparkle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="⚡"
                android:textSize="12sp"
                android:layout_marginStart="4dp"
                android:visibility="gone" />
        </LinearLayout>

        <!-- Quick Hide / Dismiss Button for In-Game Convenience -->
        <TextView
            android:id="@+id/btn_global_nav_hide"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:gravity="center"
            android:text="▼"
            android:textColor="#FF4D8D"
            android:textSize="14sp"
            android:textStyle="bold"
            android:layout_marginStart="8dp"
            android:background="@drawable/bg_melody_pill"
            android:clickable="true"
            android:focusable="true" />

    </LinearLayout>

</FrameLayout>
