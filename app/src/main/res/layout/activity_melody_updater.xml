<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#FFF5F7">

    <!-- Top Header Bar -->
    <LinearLayout
        android:id="@+id/layout_updater_header"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingHorizontal="16dp"
        android:paddingVertical="10dp"
        android:background="#FFFFFF"
        android:elevation="3dp">

        <TextView
            android:id="@+id/btn_updater_back"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="← Back"
            android:textColor="#FFFFFF"
            android:textSize="13sp"
            android:textStyle="bold"
            android:background="@drawable/bg_melody_chip_selected"
            android:paddingHorizontal="14dp"
            android:paddingVertical="6dp"
            android:clickable="true"
            android:focusable="true" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:layout_marginStart="14dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="🌸 Kids OS System &amp; App Updater"
                android:textColor="#831843"
                android:textSize="17sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tv_updater_channel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Official Release Channel: github.com/mirzaarsyad74-cmyk/kids_os"
                android:textColor="#9D174D"
                android:textSize="11sp" />
        </LinearLayout>

        <TextView
            android:id="@+id/btn_check_update_header"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="🔄 Check Now"
            android:textColor="#831843"
            android:textSize="12sp"
            android:textStyle="bold"
            android:background="@drawable/bg_melody_pill"
            android:paddingHorizontal="14dp"
            android:paddingVertical="6dp"
            android:clickable="true"
            android:focusable="true" />
    </LinearLayout>

    <!-- Content Area (Two Columns in Landscape) -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="horizontal"
        android:padding="14dp">

        <!-- Left Column: Status, Versions & Download Actions -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1.05"
            android:orientation="vertical"
            android:background="@drawable/bg_melody_card"
            android:padding="16dp"
            android:layout_marginEnd="10dp">

            <!-- Hero Update Icon & Status Badge -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:layout_marginBottom="12dp">

                <TextView
                    android:id="@+id/tv_hero_icon"
                    android:layout_width="54dp"
                    android:layout_height="54dp"
                    android:gravity="center"
                    android:text="🚀"
                    android:textSize="28sp"
                    android:background="@drawable/bg_avatar_circle" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:layout_marginStart="12dp">

                    <TextView
                        android:id="@+id/tv_update_status_badge"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="✨ You have the latest version!"
                        android:textColor="#FFFFFF"
                        android:textSize="12sp"
                        android:textStyle="bold"
                        android:background="@drawable/bg_melody_chip_selected"
                        android:paddingHorizontal="10dp"
                        android:paddingVertical="4dp"
                        android:layout_marginBottom="4dp" />

                    <TextView
                        android:id="@+id/tv_last_checked_time"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Last checked: Just now"
                        android:textColor="#9D174D"
                        android:textSize="11sp" />
                </LinearLayout>
            </LinearLayout>

            <!-- Version Information Box -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="#FFF0F5"
                android:padding="12dp"
                android:layout_marginBottom="12dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_marginBottom="6dp">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="Installed Version:"
                        android:textColor="#831843"
                        android:textSize="13sp" />

                    <TextView
                        android:id="@+id/tv_installed_version"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="v1.0.0"
                        android:textColor="#831843"
                        android:textSize="13sp"
                        android:textStyle="bold" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_marginBottom="6dp">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="Latest GitHub Release:"
                        android:textColor="#831843"
                        android:textSize="13sp" />

                    <TextView
                        android:id="@+id/tv_latest_version"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="v1.0.0"
                        android:textColor="#FF1493"
                        android:textSize="13sp"
                        android:textStyle="bold" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="Release Package Size:"
                        android:textColor="#831843"
                        android:textSize="13sp" />

                    <TextView
                        android:id="@+id/tv_package_size"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="10.9 MB"
                        android:textColor="#831843"
                        android:textSize="13sp"
                        android:textStyle="bold" />
                </LinearLayout>
            </LinearLayout>

            <!-- Download Progress Bar Card (Toggled when downloading) -->
            <LinearLayout
                android:id="@+id/card_download_progress"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="#FFE4E6"
                android:padding="12dp"
                android:layout_marginBottom="12dp"
                android:visibility="gone">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_marginBottom="6dp">

                    <TextView
                        android:id="@+id/tv_download_status_title"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="📥 Downloading Update Package..."
                        android:textColor="#831843"
                        android:textSize="12sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/tv_download_percent"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="0%"
                        android:textColor="#FF1493"
                        android:textSize="12sp"
                        android:textStyle="bold" />
                </LinearLayout>

                <ProgressBar
                    android:id="@+id/pb_download_progress"
                    style="?android:attr/progressBarStyleHorizontal"
                    android:layout_width="match_parent"
                    android:layout_height="10dp"
                    android:max="100"
                    android:progress="0"
                    android:progressDrawable="@drawable/bg_progress_melody"
                    android:layout_marginBottom="6dp" />

                <TextView
                    android:id="@+id/tv_download_metrics"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="0 MB / 10.9 MB (0 KB/s)"
                    android:textColor="#9D174D"
                    android:textSize="11sp" />
            </LinearLayout>

            <View
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1" />

            <!-- Primary Action Buttons -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/btn_action_check"
                    android:layout_width="0dp"
                    android:layout_height="44dp"
                    android:layout_weight="1"
                    android:gravity="center"
                    android:text="🔄 Refresh Status"
                    android:textColor="#831843"
                    android:textSize="13sp"
                    android:textStyle="bold"
                    android:background="@drawable/bg_melody_chip_unselected"
                    android:layout_marginEnd="6dp"
                    android:clickable="true"
                    android:focusable="true" />

                <TextView
                    android:id="@+id/btn_action_download"
                    android:layout_width="0dp"
                    android:layout_height="44dp"
                    android:layout_weight="1.5"
                    android:gravity="center"
                    android:text="🌸 Download &amp; Update"
                    android:textColor="#FFFFFF"
                    android:textSize="13sp"
                    android:textStyle="bold"
                    android:background="@drawable/bg_melody_chip_selected"
                    android:clickable="true"
                    android:focusable="true" />
            </LinearLayout>
        </LinearLayout>

        <!-- Right Column: Changelog / Release Notes -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1.15"
            android:orientation="vertical"
            android:background="@drawable/bg_melody_card"
            android:padding="16dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginBottom="8dp">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="📜 Release Notes &amp; Highlights"
                    android:textColor="#831843"
                    android:textSize="15sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tv_release_date"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Published: Sep 2026"
                    android:textColor="#9D174D"
                    android:textSize="11sp" />
            </LinearLayout>

            <ScrollView
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:background="#FFF9FB"
                android:padding="12dp">

                <TextView
                    android:id="@+id/tv_release_changelog"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Checking for latest release notes on GitHub..."
                    android:textColor="#4A0E2E"
                    android:textSize="13sp"
                    android:lineSpacingExtra="4dp" />
            </ScrollView>

            <TextView
                android:id="@+id/btn_open_github_release"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:text="🌐 View Release on GitHub.com"
                android:textColor="#831843"
                android:textSize="12sp"
                android:textStyle="bold"
                android:background="@drawable/bg_melody_pill"
                android:paddingVertical="8dp"
                android:layout_marginTop="10dp"
                android:clickable="true"
                android:focusable="true" />
        </LinearLayout>
    </LinearLayout>

</LinearLayout>
