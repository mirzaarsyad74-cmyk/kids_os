<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Pink Gradient Background -->
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="24dp" />
            <gradient
                android:startColor="#F472B6"
                android:endColor="#DB2777"
                android:angle="135" />
            <stroke android:width="2dp" android:color="#FFFFFF" />
        </shape>
    </item>
    <!-- White Inner Picture Frame -->
    <item android:top="14dp" android:bottom="14dp" android:left="14dp" android:right="14dp">
        <shape android:shape="rectangle">
            <corners android:radius="14dp" />
            <solid android:color="#FFFFFF" />
        </shape>
    </item>
    <!-- Photo Inner Area -->
    <item android:top="19dp" android:bottom="19dp" android:left="19dp" android:right="19dp">
        <shape android:shape="rectangle">
            <corners android:radius="10dp" />
            <solid android:color="#FCE7F3" />
            <stroke android:width="1dp" android:color="#FBCFE8" />
        </shape>
    </item>
    <!-- Sun / Sparkle Circle in Photo -->
    <item android:top="23dp" android:bottom="37dp" android:left="37dp" android:right="23dp">
        <shape android:shape="oval">
            <solid android:color="#F59E0B" />
        </shape>
    </item>
    <!-- Sweet Hill / Mountain in Photo -->
    <item android:top="33dp" android:bottom="22dp" android:left="22dp" android:right="22dp">
        <shape android:shape="oval">
            <solid android:color="#EC4899" />
        </shape>
    </item>
</layer-list>
