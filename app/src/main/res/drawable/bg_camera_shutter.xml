<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Outer pink glow ring -->
    <item>
        <shape android:shape="oval">
            <solid android:color="#FFE4E6" />
            <stroke android:width="4dp" android:color="#FF4D8D" />
        </shape>
    </item>
    <!-- Inner hot pink camera button -->
    <item android:top="8dp" android:bottom="8dp" android:left="8dp" android:right="8dp">
        <shape android:shape="oval">
            <gradient
                android:startColor="#FF65A5"
                android:endColor="#FF2A85"
                android:angle="270" />
            <stroke android:width="2dp" android:color="#FFFFFF" />
        </shape>
    </item>
</layer-list>
