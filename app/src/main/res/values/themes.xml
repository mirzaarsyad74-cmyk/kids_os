<resources>
    <style name="Theme.KidsLauncher" parent="Theme.MaterialComponents.DayNight.NoActionBar">
        <item name="colorPrimary">@color/kids_primary</item>
        <item name="colorPrimaryDark">@color/kids_primary_dark</item>
        <item name="colorAccent">@color/kids_accent</item>
        <item name="android:windowBackground">@color/kids_sky_end</item>
    </style>

    <style name="Theme.KidsLauncher.Fullscreen" parent="Theme.KidsLauncher">
        <item name="android:windowFullscreen">true</item>
        <item name="android:windowContentOverlay">@null</item>
    </style>

    <!-- Melody Calculator Button Styles -->
    <style name="MelodyCalcBtnNumber">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">0dp</item>
        <item name="android:layout_columnWeight">1</item>
        <item name="android:layout_rowWeight">1</item>
        <item name="android:gravity">center</item>
        <item name="android:background">@drawable/bg_melody_card</item>
        <item name="android:textColor">#831843</item>
        <item name="android:textSize">22sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:clickable">true</item>
        <item name="android:focusable">true</item>
        <item name="android:layout_margin">3dp</item>
        <item name="android:elevation">2dp</item>
    </style>

    <style name="MelodyCalcBtnOperator">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">0dp</item>
        <item name="android:layout_columnWeight">1</item>
        <item name="android:layout_rowWeight">1</item>
        <item name="android:gravity">center</item>
        <item name="android:background">@drawable/bg_melody_pill</item>
        <item name="android:textColor">#9D174D</item>
        <item name="android:textSize">20sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:clickable">true</item>
        <item name="android:focusable">true</item>
        <item name="android:layout_margin">3dp</item>
        <item name="android:elevation">2dp</item>
    </style>

    <style name="MelodyCalcBtnEquals">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">0dp</item>
        <item name="android:layout_columnWeight">1</item>
        <item name="android:layout_rowWeight">1</item>
        <item name="android:gravity">center</item>
        <item name="android:background">@drawable/bg_melody_chip_selected</item>
        <item name="android:textColor">#FFFFFF</item>
        <item name="android:textSize">24sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:clickable">true</item>
        <item name="android:focusable">true</item>
        <item name="android:layout_margin">3dp</item>
        <item name="android:elevation">4dp</item>
    </style>

    <style name="MelodyTimerPreset">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">32dp</item>
        <item name="android:gravity">center</item>
        <item name="android:background">@drawable/bg_melody_pill</item>
        <item name="android:textColor">#831843</item>
        <item name="android:textSize">13sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:paddingHorizontal">12dp</item>
        <item name="android:layout_marginHorizontal">4dp</item>
        <item name="android:clickable">true</item>
        <item name="android:focusable">true</item>
    </style>
</resources>
